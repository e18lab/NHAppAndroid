# Скопируй в .env и подставь свой URL бэкенда (nappi или nhapp-api).
#
# Локально (nappi на ПК):
#   EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3002
#
# Android Emulator: localhost указывает на эмулятор — либо:
#   adb reverse tcp:3002 tcp:3002
#   и оставь 127.0.0.1:3002,
# либо укажи IP машины в LAN, например http://192.168.1.10:3002
#
# Web / Electron: прокси nhentai строится как {EXPO_PUBLIC_API_BASE_URL}/fpi

EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3002

# EXPO_PUBLIC_NHENTAI_API_KEY=
